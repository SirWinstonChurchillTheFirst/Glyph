{
  "name": "glyph",
  "version": "0.2.4",
  "description": "Decision help for League of Legends champion select: runes, items and matchups, each with its reasons.",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "update-data": "node scripts/update-data.ts",
    "dist": "electron-vite build && electron-builder --win && node scripts/checksum.cjs",
    "icon": "electron scripts/make-icon.cjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "io.github.sirwinstonchurchillthefirst.glyph",
    "productName": "Glyph",
    "copyright": "Copyright © 2026 SirWinstonChurchillTheFirst – GPL-3.0",
    "files": [
      "out/**",
      "data/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Glyph-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "shortcutName": "Glyph",
      "uninstallDisplayName": "Glyph",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "author": "SirWinstonChurchillTheFirst",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/SirWinstonChurchillTheFirst/Glyph.git"
  }
}
